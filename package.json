{
  "name": "loica",
  "private": true,
  "type": "module",
  "description": "Self-hosted collaborative Markdown editor with real-time sync, workspaces, and an extension system.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.12.1"
  },
  "homepage": "https://github.com/critica-tech-lab/loica",
  "repository": {
    "type": "git",
    "url": "https://github.com/critica-tech-lab/loica.git"
  },
  "scripts": {
    "dev": "react-router dev",
    "dev:all": "bun run dev & bun run ws & wait",
    "stop": "pkill -f 'ws-server.ts' || true; pkill -f 'react-router dev' || true",
    "ws": "node ws-server.ts",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "check:colors": "node scripts/check-colors.mjs",
    "typecheck": "react-router typegen && tsc && node scripts/check-colors.mjs",
    "lint": "eslint app ws-server.ts ws",
    "test": "bun test && node scripts/test-db.mjs",
    "test:db": "node scripts/test-db.mjs",
    "restart": "fuser -k 4000/tcp 2>/dev/null; fuser -k 4001/tcp 2>/dev/null; sleep 1 && bun run build && (bun run dev:all &)",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "overrides": {
    "qs": "^6.16.0",
    "vite": "^8.2.2",
    "esbuild": "^0.28.0",
    "morgan": "^1.12.0",
    "prosemirror-view": "^1.42.3",
    "prosemirror-transform": "^1.12.1",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@manuscripts/track-changes-plugin": "^2.4.0",
    "@manuscripts/transform": "^4.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "docx": "^9.15.0",
    "isbot": "^5.2.2",
    "isomorphic-dompurify": "^4.6.0",
    "jose": "^6.2.13",
    "jszip": "^3.10.2",
    "marked": "^18.1.2",
    "marked-footnote": "^1.4.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.2.1",
    "pdfmake": "^0.3.13",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-docx": "^0.6.1",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-resizable-view": "^3.0.0",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-trailing-node": "^3.0.0",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "reveal.js": "^6.0.2",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "ws": "^8.22.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^1.6.4"
  }
}
