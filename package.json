{
  "name": "loica",
  "private": true,
  "type": "module",
  "description": "Self-hosted collaborative Markdown editor with real-time sync, workspaces, and an extension system.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/critica-tech-lab/loica",
  "repository": {
    "type": "git",
    "url": "https://github.com/critica-tech-lab/loica.git"
  },
  "scripts": {
    "dev": "react-router dev",
    "dev:all": "bun run dev & bun run ws & wait",
    "stop": "pkill -f 'ws-server.ts' || true; pkill -f 'react-router dev' || true",
    "ws": "node ws-server.ts",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "check:colors": "node scripts/check-colors.mjs",
    "typecheck": "react-router typegen && tsc && node scripts/check-colors.mjs",
    "restart": "fuser -k 4000/tcp 2>/dev/null; fuser -k 4001/tcp 2>/dev/null; sleep 1 && bun run build && (bun run dev:all &)",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "overrides": {
    "qs": "^6.16.0",
    "vite": "^8.2.2",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@manuscripts/track-changes-plugin": "^2.4.0",
    "@manuscripts/transform": "^4.5.4",
    "@node-rs/argon2": "^2.2.0",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "isbot": "^5.2.2",
    "isomorphic-dompurify": "^4.1.0",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "marked": "^18.0.11",
    "marked-footnote": "^1.4.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^9.1.1",
    "pdfmake": "^0.3.11",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-docx": "^0.6.1",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.25.11",
    "prosemirror-resizable-view": "^3.0.0",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-trailing-node": "^3.0.0",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "reveal.js": "^6.0.1",
    "sharp": "^0.35.4",
    "turndown": "^7.2.4",
    "ws": "^8.21.3",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^1.6.4"
  }
}
